# Copy this file to .env and fill in your Contrast Agent Token.
#   cp .env.example .env
#
# Get the token from the Contrast UI: Add new > select Java agent, or your
# organization's agent keys page. It is one long base64 string that already
# contains the URL and keys.
CONTRAST_TOKEN=

# Set KIND=1 to spin up a throwaway kind cluster (recommended, and the default
# here). Set KIND=0 to instead use your current kubectl context.
KIND=1

# Optional. The kubectl context to deploy into when KIND=0. Leave blank to use
# whatever your current context is. Set this as a safety check so you don't
# deploy into the wrong cluster by accident.
KUBE_CONTEXT=

# --- Contrast API credentials (optional, for clearing UI results on teardown) ---
# teardown.sh uses these to wipe this app's findings from the Contrast UI so the next
# demo run starts fresh. Find both in the Contrast UI under User settings > API.
# If left blank, teardown simply skips the UI-clear step.
CONTRAST_API_KEY=
CONTRAST_AUTH_HEADER=

# Optional. Application name to clear (must match the name in the Helm values).
# Defaults to "WebGoat IAST/ADR Demo" if left blank.
CONTRAST_APP_NAME=

# Optional. What teardown clears:
#   issues (default) - wipes findings, Protect attack incidents, and route coverage;
#                      KEEPS library data and the app. Needs only the Edit role
#                      (route-coverage delete needs Admin; best-effort, skips on 403).
#   reset            - purges ALL data incl. the Behavior/flow (Observe) tab AND
#                      libraries, but keeps the app. The only way to clear Behavior.
#                      Requires an Admin-role Authorization header.
#   app              - deletes the whole application. Requires Admin.
CONTRAST_CLEAR_MODE=
